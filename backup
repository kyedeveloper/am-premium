<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#07080d">
<title>Alight Motion Premium — Activation Center</title>

<script src="https://unpkg.com/lucide@latest"></script>

<style>
:root{
    --bg:#05060a;
    --panel:#0b0d13;
    --panel2:#10131b;
    --line:rgba(255,255,255,.07);
    --line2:rgba(255,255,255,.12);
    --text:#f4f7ff;
    --muted:#8b93a7;
    --muted2:#626a7e;
    --blue:#5b7cff;
    --purple:#8b5cf6;
    --green:#2dd47b;
    --red:#ff5c67;
    --yellow:#f5c451;
    --radius:24px;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    min-height:100vh;
    color:var(--text);
    background:
        radial-gradient(circle at 75% 5%,rgba(91,124,255,.12),transparent 28%),
        radial-gradient(circle at 15% 80%,rgba(139,92,246,.08),transparent 25%),
        var(--bg);
    overflow-x:hidden;
}

button,
input{
    font:inherit;
}

button{
    cursor:pointer;
}

::-webkit-scrollbar{
    width:5px;
}

::-webkit-scrollbar-track{
    background:#05060a;
}

::-webkit-scrollbar-thumb{
    background:#242a38;
    border-radius:20px;
}

/* BACKGROUND */

.background-grid{
    position:fixed;
    inset:0;
    pointer-events:none;
    opacity:.22;
    background-image:
        linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),
        linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);
    background-size:70px 70px;
    mask-image:linear-gradient(to bottom,black,transparent 85%);
}

.glow{
    position:fixed;
    width:500px;
    height:500px;
    border-radius:50%;
    filter:blur(130px);
    pointer-events:none;
    opacity:.13;
}

.glow.one{
    background:#4267ff;
    top:-300px;
    right:-150px;
}

.glow.two{
    background:#8b5cf6;
    bottom:-300px;
    left:-180px;
}

/* APP */

.app{
    width:min(1500px,100%);
    min-height:100vh;
    margin:auto;
    display:flex;
    position:relative;
    z-index:2;
}

/* SIDEBAR */

.sidebar{
    width:250px;
    min-height:100vh;
    border-right:1px solid var(--line);
    padding:28px 18px;
    position:sticky;
    top:0;
    height:100vh;
    background:rgba(5,6,10,.72);
    backdrop-filter:blur(24px);
}

.logo{
    display:flex;
    align-items:center;
    gap:12px;
    padding:4px 8px 28px;
}

.logo-mark{
    width:42px;
    height:42px;
    border-radius:13px;
    display:grid;
    place-items:center;
    background:
        linear-gradient(145deg,#617cff,#7b4df4);
    box-shadow:
        0 12px 35px rgba(91,124,255,.25);
}

.logo-mark svg{
    width:22px;
}

.logo-text strong{
    display:block;
    font-size:14px;
    letter-spacing:.3px;
}

.logo-text span{
    display:block;
    color:var(--muted2);
    font-size:10px;
    margin-top:2px;
    text-transform:uppercase;
    letter-spacing:1.5px;
}

.menu-title{
    color:#51586a;
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:1.6px;
    padding:0 11px;
    margin:18px 0 8px;
}

.nav{
    display:flex;
    flex-direction:column;
    gap:4px;
}

.nav button{
    width:100%;
    border:0;
    background:transparent;
    color:#737b8e;
    display:flex;
    align-items:center;
    gap:12px;
    padding:12px 13px;
    border-radius:13px;
    text-align:left;
    transition:.2s;
}

.nav button:hover{
    background:rgba(255,255,255,.04);
    color:#dfe5f5;
}

.nav button.active{
    background:
        linear-gradient(90deg,rgba(91,124,255,.15),rgba(91,124,255,.04));
    color:#fff;
    border:1px solid rgba(91,124,255,.12);
}

.nav button svg{
    width:17px;
}

.sidebar-bottom{
    position:absolute;
    left:18px;
    right:18px;
    bottom:22px;
}

.api-mini{
    padding:13px;
    border:1px solid var(--line);
    border-radius:16px;
    background:rgba(255,255,255,.025);
}

.api-mini-top{
    display:flex;
    align-items:center;
    justify-content:space-between;
    font-size:11px;
    color:#777f91;
}

.api-state{
    display:flex;
    align-items:center;
    gap:7px;
    color:#cfd6e6;
}

.api-dot{
    width:7px;
    height:7px;
    border-radius:50%;
    background:var(--green);
    box-shadow:0 0 10px rgba(45,212,123,.5);
}

.api-dot.offline{
    background:var(--red);
    box-shadow:none;
}

.api-mini small{
    display:block;
    color:#4f5668;
    margin-top:8px;
}

/* MAIN */

.main{
    flex:1;
    min-width:0;
    padding:24px 34px 50px;
}

/* TOPBAR */

.topbar{
    height:54px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:35px;
}

.breadcrumb{
    color:#666e81;
    font-size:12px;
}

.breadcrumb strong{
    color:#cdd4e4;
    font-weight:500;
}

.top-actions{
    display:flex;
    align-items:center;
    gap:10px;
}

.top-button{
    width:38px;
    height:38px;
    border-radius:11px;
    border:1px solid var(--line);
    background:rgba(255,255,255,.025);
    color:#81899c;
    display:grid;
    place-items:center;
}

.top-button:hover{
    color:white;
    background:rgba(255,255,255,.06);
}

/* HERO */

.hero{
    display:grid;
    grid-template-columns:1.5fr .8fr;
    gap:30px;
    margin-bottom:28px;
}

.hero-copy{
    padding:20px 0;
}

.eyebrow{
    display:inline-flex;
    align-items:center;
    gap:8px;
    color:#92a5e8;
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:1.8px;
    margin-bottom:16px;
}

.eyebrow span{
    width:6px;
    height:6px;
    border-radius:50%;
    background:#6685ff;
    box-shadow:0 0 12px #6685ff;
}

.hero h1{
    font-size:clamp(36px,5vw,64px);
    line-height:1.02;
    letter-spacing:-3px;
    max-width:780px;
    font-weight:700;
}

.hero h1 em{
    font-style:normal;
    background:linear-gradient(100deg,#91a8ff,#a277ff);
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
}

.hero p{
    max-width:650px;
    color:#747d91;
    line-height:1.8;
    font-size:14px;
    margin-top:20px;
}

.hero-stats{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
    align-self:end;
}

.stat{
    border:1px solid var(--line);
    background:rgba(255,255,255,.025);
    border-radius:18px;
    padding:18px;
}

.stat span{
    display:block;
    color:#555d70;
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:1px;
}

.stat strong{
    display:block;
    font-size:20px;
    margin-top:7px;
}

/* WORKSPACE */

.workspace{
    display:grid;
    grid-template-columns:minmax(0,1fr) 330px;
    gap:18px;
}

/* ACTIVATION */

.activation{
    border:1px solid var(--line);
    background:rgba(10,12,18,.82);
    border-radius:28px;
    overflow:hidden;
}

.activation-head{
    padding:24px 26px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    border-bottom:1px solid var(--line);
}

.activation-title{
    display:flex;
    align-items:center;
    gap:12px;
}

.activation-icon{
    width:42px;
    height:42px;
    display:grid;
    place-items:center;
    border-radius:13px;
    background:rgba(91,124,255,.1);
    color:#8298ff;
}

.activation-title h2{
    font-size:16px;
    font-weight:600;
}

.activation-title p{
    color:#565e70;
    font-size:11px;
    margin-top:3px;
}

.session-badge{
    display:flex;
    align-items:center;
    gap:7px;
    color:#747c8f;
    font-size:10px;
    padding:7px 10px;
    border:1px solid var(--line);
    border-radius:30px;
}

.session-badge i{
    width:6px;
    height:6px;
    background:#596275;
    border-radius:50%;
}

/* PROGRESS */

.progress{
    padding:20px 26px 4px;
}

.progress-track{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
}

.progress-step{
    position:relative;
}

.progress-line{
    height:3px;
    background:#171b25;
    border-radius:5px;
    margin-bottom:9px;
    overflow:hidden;
}

.progress-line div{
    height:100%;
    width:0;
    background:linear-gradient(90deg,#5b7cff,#8b5cf6);
    transition:.5s;
}

.progress-step.active .progress-line div{
    width:100%;
}

.progress-label{
    display:flex;
    align-items:center;
    gap:8px;
    font-size:10px;
    color:#5d6577;
}

.progress-step.active .progress-label{
    color:#b6c3ed;
}

/* FORMS */

.form-area{
    padding:22px 26px 28px;
}

.step{
    border:1px solid var(--line);
    border-radius:21px;
    padding:20px;
    background:rgba(255,255,255,.018);
}

.step + .step{
    margin-top:12px;
}

.step.disabled{
    opacity:.38;
    pointer-events:none;
}

.step-header{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:15px;
    margin-bottom:18px;
}

.step-number{
    font-size:9px;
    color:#7487c4;
    letter-spacing:1.5px;
    text-transform:uppercase;
}

.step h3{
    font-size:15px;
    margin-top:5px;
    font-weight:600;
}

.step-desc{
    color:#555e71;
    font-size:11px;
    margin-top:4px;
}

.step-check{
    width:28px;
    height:28px;
    border-radius:9px;
    display:grid;
    place-items:center;
    background:#111722;
    color:#50586b;
}

.step-check.done{
    background:rgba(45,212,123,.1);
    color:var(--green);
}

/* INPUT */

.field{
    margin-top:13px;
}

.field label{
    display:block;
    color:#788196;
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:1px;
    margin-bottom:7px;
}

.input{
    min-height:49px;
    border:1px solid var(--line);
    background:#080a0f;
    border-radius:14px;
    display:flex;
    align-items:center;
    padding:0 6px 0 14px;
    transition:.2s;
}

.input:focus-within{
    border-color:rgba(91,124,255,.5);
    box-shadow:0 0 0 3px rgba(91,124,255,.07);
}

.input svg{
    width:16px;
    color:#596276;
    margin-right:9px;
    flex-shrink:0;
}

.input input{
    flex:1;
    min-width:0;
    border:0;
    outline:0;
    background:transparent;
    color:white;
    font-size:13px;
}

.input input::placeholder{
    color:#3f4655;
}

.input-actions{
    display:flex;
}

.input-actions button{
    width:34px;
    height:34px;
    display:grid;
    place-items:center;
    background:transparent;
    border:0;
    border-radius:9px;
    color:#596276;
}

.input-actions button:hover{
    color:white;
    background:rgba(255,255,255,.05);
}

.error{
    color:#ff6c76;
    font-size:10px;
    margin-top:6px;
}

.action{
    margin-top:15px;
    width:100%;
    min-height:48px;
    border:0;
    border-radius:14px;
    color:white;
    background:linear-gradient(100deg,#4c6fff,#7849ef);
    font-size:12px;
    font-weight:600;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:9px;
    box-shadow:0 10px 30px rgba(74,93,255,.16);
    transition:.2s;
}

.action:hover:not(:disabled){
    transform:translateY(-1px);
    box-shadow:0 14px 35px rgba(74,93,255,.24);
}

.action:disabled{
    opacity:.45;
    cursor:not-allowed;
}

.secondary-actions{
    display:flex;
    gap:8px;
    margin-top:10px;
}

.small-btn{
    border:1px solid var(--line);
    background:rgba(255,255,255,.025);
    color:#70798c;
    padding:8px 11px;
    border-radius:10px;
    font-size:10px;
}

.small-btn:hover{
    color:white;
    background:rgba(255,255,255,.05);
}

.step-status{
    min-height:18px;
    color:#626b7e;
    font-size:10px;
    margin-top:8px;
}

/* SIDE PANEL */

.side-panel{
    display:flex;
    flex-direction:column;
    gap:14px;
}

.panel{
    border:1px solid var(--line);
    background:rgba(10,12,18,.78);
    border-radius:23px;
    padding:20px;
}

.panel-title{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:18px;
}

.panel-title h3{
    font-size:13px;
    font-weight:600;
}

.panel-title span{
    color:#4e5668;
    font-size:9px;
}

.status-main{
    display:flex;
    align-items:center;
    gap:13px;
    padding:14px;
    border-radius:15px;
    background:rgba(255,255,255,.025);
}

.big-status{
    width:38px;
    height:38px;
    border-radius:12px;
    display:grid;
    place-items:center;
    background:#151924;
    color:#596275;
}

.big-status.success{
    color:var(--green);
    background:rgba(45,212,123,.08);
}

.big-status.error{
    color:var(--red);
    background:rgba(255,92,103,.08);
}

.big-status.processing{
    color:var(--yellow);
    background:rgba(245,196,81,.08);
}

.status-main strong{
    display:block;
    font-size:12px;
}

.status-main small{
    color:#596275;
    font-size:10px;
    display:block;
    margin-top:4px;
}

/* LOGS */

.logs{
    max-height:250px;
    overflow-y:auto;
}

.log{
    display:flex;
    gap:10px;
    padding:10px 0;
    border-bottom:1px solid rgba(255,255,255,.035);
}

.log:last-child{
    border-bottom:0;
}

.log-icon{
    width:26px;
    height:26px;
    border-radius:8px;
    display:grid;
    place-items:center;
    background:#12151d;
    color:#5f687b;
    flex-shrink:0;
}

.log-text{
    min-width:0;
}

.log-text strong{
    display:block;
    color:#aeb6c8;
    font-size:10px;
    font-weight:500;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.log-text span{
    display:block;
    color:#4d5567;
    font-size:9px;
    margin-top:3px;
}

/* SECURITY */

.security-list{
    display:flex;
    flex-direction:column;
    gap:11px;
}

.security-item{
    display:flex;
    align-items:center;
    gap:10px;
    color:#777f91;
    font-size:10px;
}

.security-item svg{
    color:#596eab;
    width:15px;
}

/* FOOTER */

.footer{
    margin-top:35px;
    padding-top:20px;
    border-top:1px solid var(--line);
    display:flex;
    justify-content:space-between;
    gap:20px;
    color:#444c5e;
    font-size:10px;
}

.footer-links{
    display:flex;
    gap:20px;
}

.footer-links button{
    border:0;
    background:none;
    color:#626a7b;
    font-size:10px;
}

/* TOAST */

.toast-container{
    position:fixed;
    right:20px;
    top:20px;
    width:min(370px,calc(100vw - 40px));
    z-index:9999;
    display:flex;
    flex-direction:column;
    gap:8px;
}

.toast{
    display:flex;
    align-items:center;
    gap:10px;
    padding:13px 14px;
    border-radius:14px;
    background:rgba(15,18,25,.96);
    border:1px solid var(--line2);
    box-shadow:0 20px 50px rgba(0,0,0,.45);
    color:#dce2f0;
    font-size:11px;
    animation:toastIn .25s ease;
}

.toast.success{
    border-left:3px solid var(--green);
}

.toast.error{
    border-left:3px solid var(--red);
}

.toast.info{
    border-left:3px solid var(--blue);
}

.toast button{
    margin-left:auto;
    background:none;
    border:0;
    color:#626a7d;
}

@keyframes toastIn{
    from{
        opacity:0;
        transform:translateY(-8px);
    }
    to{
        opacity:1;
        transform:none;
    }
}

/* MODAL */

.modal{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.75);
    backdrop-filter:blur(12px);
    display:grid;
    place-items:center;
    padding:20px;
    z-index:10000;
}

.modal.hidden{
    display:none;
}

.modal-box{
    width:min(500px,100%);
    background:#0c0f16;
    border:1px solid var(--line2);
    border-radius:23px;
    padding:23px;
    box-shadow:0 40px 100px rgba(0,0,0,.65);
}

.modal-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:15px;
}

.modal-head h3{
    font-size:15px;
}

.modal-close{
    border:0;
    background:none;
    color:#687184;
}

.modal-body{
    color:#747d91;
    line-height:1.7;
    font-size:11px;
}


/* THEME VIDEO SLIDER */
.theme-slider{position:relative;width:100%;margin-bottom:18px;overflow:hidden;border:1px solid var(--line);border-radius:26px;background:#fff;box-shadow:0 18px 50px rgba(0,0,0,.18);touch-action:pan-y}
.theme-track{display:flex;width:200%;transform:translateX(0);transition:transform .5s cubic-bezier(.22,.61,.36,1)}
.theme-slide{position:relative;flex:0 0 50%;min-height:230px;overflow:hidden;background:#fff}
.theme-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.theme-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,255,255,.94),rgba(255,255,255,.48) 42%,rgba(255,255,255,.04));pointer-events:none}
.theme-pink .theme-overlay{background:linear-gradient(90deg,rgba(20,3,18,.9),rgba(255,20,180,.35) 48%,rgba(255,0,140,.08))}
.theme-info{position:absolute;left:26px;bottom:25px;z-index:2;display:flex;flex-direction:column;gap:5px;color:#171923}
.theme-info span{font-size:9px;letter-spacing:2px;font-weight:700;opacity:.55}.theme-info strong{font-size:28px;letter-spacing:-1px}.theme-info small{font-size:10px;opacity:.58}
.theme-pink .theme-info{color:#fff}.theme-pink .theme-info span{color:#ff72d0;opacity:1}
.theme-dots{position:absolute;left:50%;bottom:13px;transform:translateX(-50%);display:flex;gap:7px;z-index:4}
.theme-dot{width:7px;height:7px;padding:0;border:0;border-radius:50%;background:rgba(0,0,0,.22);transition:.25s}.theme-dot.active{width:20px;border-radius:10px;background:#111}
body.theme-white{--bg:#f4f6fa;--panel:#fff;--panel2:#f8f9fc;--line:rgba(20,27,45,.10);--line2:rgba(20,27,45,.16);--text:#151923;--muted:#687083;--muted2:#8a91a0;color:#151923;background:radial-gradient(circle at 75% 5%,rgba(91,124,255,.10),transparent 28%),radial-gradient(circle at 15% 80%,rgba(139,92,246,.06),transparent 25%),var(--bg)}
body.theme-white .sidebar{background:rgba(255,255,255,.78)}body.theme-white .activation,body.theme-white .panel{background:rgba(255,255,255,.84)}body.theme-white .step,body.theme-white .stat,body.theme-white .api-mini,body.theme-white .top-button{background:rgba(20,27,45,.035)}body.theme-white .input{background:#f7f8fb}body.theme-white .input input{color:#151923}
body.theme-pink{--bg:#0d0310;--panel:#17071a;--panel2:#220a25;--line:rgba(255,92,211,.16);--line2:rgba(255,92,211,.28);--text:#fff4fd;--muted:#c39ab9;--muted2:#8f607f;--blue:#ff4fc3;--purple:#b84cff;color:#fff4fd;background:radial-gradient(circle at 78% 4%,rgba(255,20,180,.25),transparent 30%),radial-gradient(circle at 15% 80%,rgba(179,50,255,.18),transparent 28%),#0d0310)}
body.theme-pink .sidebar{background:rgba(13,3,16,.78);box-shadow:10px 0 50px rgba(255,20,180,.06)}body.theme-pink .activation,body.theme-pink .panel{background:rgba(23,7,26,.84);box-shadow:0 15px 50px rgba(255,20,180,.07)}body.theme-pink .step,body.theme-pink .stat,body.theme-pink .api-mini,body.theme-pink .top-button{background:rgba(255,92,211,.045)}body.theme-pink .input{background:#100510}body.theme-pink .action{background:linear-gradient(100deg,#ff32bb,#a83dff);box-shadow:0 10px 35px rgba(255,32,190,.22)}body.theme-pink .progress-line div{background:linear-gradient(90deg,#ff3ec0,#b84cff)}
.theme-slider,.sidebar,.activation,.panel,.stat,.step,.input,.api-mini,.footer,.top-button{transition:background .45s ease,color .45s ease,border-color .45s ease,box-shadow .45s ease}
@media(max-width:760px){.theme-slide{min-height:190px}.theme-info{left:19px;bottom:23px}.theme-info strong{font-size:24px}}

/* MOBILE */

.mobile-header{
    display:none;
}

@media(max-width:1050px){
    .sidebar{
        width:210px;
    }

    .main{
        padding-left:24px;
        padding-right:24px;
    }

    .hero{
        grid-template-columns:1fr;
    }

    .hero-stats{
        max-width:600px;
    }

    .workspace{
        grid-template-columns:1fr;
    }

    .side-panel{
        display:grid;
        grid-template-columns:1fr 1fr;
    }
}

@media(max-width:760px){
    .sidebar{
        display:none;
    }

    .main{
        padding:15px 15px 35px;
    }

    .mobile-header{
        display:flex;
        align-items:center;
        justify-content:space-between;
        margin-bottom:25px;
    }

    .mobile-logo{
        display:flex;
        align-items:center;
        gap:9px;
        font-size:12px;
        font-weight:600;
    }

    .mobile-logo-mark{
        width:34px;
        height:34px;
        display:grid;
        place-items:center;
        border-radius:10px;
        background:linear-gradient(145deg,#617cff,#7b4df4);
    }

    .topbar{
        display:none;
    }

    .hero{
        margin-bottom:20px;
    }

    .hero h1{
        font-size:39px;
        letter-spacing:-2px;
    }

    .hero p{
        font-size:12px;
    }

    .hero-stats{
        grid-template-columns:repeat(3,1fr);
    }

    .stat{
        padding:13px;
    }

    .stat strong{
        font-size:16px;
    }

    .workspace{
        display:block;
    }

    .side-panel{
        display:flex;
        margin-top:15px;
    }

    .activation-head{
        padding:19px;
    }

    .progress{
        padding:17px 19px 3px;
    }

    .form-area{
        padding:18px 15px 20px;
    }

    .step{
        padding:16px;
    }

    .session-badge{
        display:none;
    }

    .footer{
        flex-direction:column;
    }
}

@media(max-width:430px){
    .hero h1{
        font-size:34px;
    }

    .hero-stats{
        gap:6px;
    }

    .stat{
        border-radius:13px;
    }

    .stat span{
        font-size:8px;
    }

    .stat strong{
        font-size:14px;
    }
}

.hidden{
    display:none!important;
}

.spinner{
    animation:spin .8s linear infinite;
}

@keyframes spin{
    to{
        transform:rotate(360deg);
    }
}
</style>
</head>

<body>

<div class="background-grid"></div>
<div class="glow one"></div>
<div class="glow two"></div>

<div class="app">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="logo">
            <div class="logo-mark">
                <i data-lucide="layers"></i>
            </div>
            <div class="logo-text">
                <strong>Alight Motion</strong>
                <span>Premium Center</span>
            </div>
        </div>

        <div class="menu-title">Workspace</div>

        <nav class="nav">
            <button class="active" data-target="activationArea">
                <i data-lucide="layout-dashboard"></i>
                Dashboard
            </button>

            <button data-target="activationArea">
                <i data-lucide="key-round"></i>
                Activation
            </button>

            <button data-target="statusArea">
                <i data-lucide="activity"></i>
                Status
            </button>

            <button data-target="securityArea">
                <i data-lucide="shield-check"></i>
                Security
            </button>
        </nav>

        <div class="menu-title">System</div>

        <nav class="nav">
            <button id="resetNav">
                <i data-lucide="rotate-ccw"></i>
                Reset Session
            </button>
        </nav>

        <div class="sidebar-bottom">

            <div class="api-mini">
                <div class="api-mini-top">
                    <span>Service Status</span>

                    <span class="api-state">
                        <i class="api-dot" id="apiDot"></i>
                        <span id="apiLabel">Checking</span>
                    </span>
                </div>

                <small id="apiEndpoint">
                    Activation API
                </small>
            </div>

        </div>
    </aside>

    <!-- MAIN -->
    <main class="main">

        <!-- MOBILE HEADER -->
        <div class="mobile-header">
            <div class="mobile-logo">
                <div class="mobile-logo-mark">
                    <i data-lucide="layers" size="17"></i>
                </div>
                Alight Motion Premium
            </div>

            <button class="top-button" id="mobileReset">
                <i data-lucide="rotate-ccw" size="16"></i>
            </button>
        </div>

        <!-- TOPBAR -->
        <div class="topbar">

            <div class="breadcrumb">
                Workspace / <strong>Premium Activation</strong>
            </div>

            <div class="top-actions">
                <button class="top-button" id="clearLogsBtn" title="Clear activity">
                    <i data-lucide="trash-2" size="16"></i>
                </button>

                <button class="top-button" id="refreshApiBtn" title="Check API">
                    <i data-lucide="refresh-cw" size="16"></i>
                </button>
            </div>

        </div>

        <!-- HERO -->
        <section class="hero">

            <div class="hero-copy">

                <div class="eyebrow">
                    <span></span>
                    Secure Activation Center
                </div>

                <h1>
                    Premium access,
                    <em>without the clutter.</em>
                </h1>

                <p>
                    Request a magic link, verify the authorized account,
                    then complete the Premium activation from one focused
                    workspace.
                </p>

            </div>

            <div class="hero-stats">

                <div class="stat">
                    <span>Protocol</span>
                    <strong>HTTPS</strong>
                </div>

                <div class="stat">
                    <span>Steps</span>
                    <strong>02</strong>
                </div>

                <div class="stat">
                    <span>Requests</span>
                    <strong id="requestCounter">0</strong>
                </div>

            </div>

        </section>

        <!-- WORKSPACE -->
        <section class="workspace">

            <!-- THEME VIDEO SLIDER -->
            <div class="theme-slider" id="themeSlider" aria-label="Theme selector">
                <div class="theme-track" id="themeTrack">
                    <article class="theme-slide theme-white active">
                        <video class="theme-video" src="video1.mp4" autoplay muted loop playsinline preload="metadata"></video>
                        <div class="theme-overlay"></div>
                        <div class="theme-info"><span>THEME 01</span><strong>White</strong><small>Swipe right for the next theme</small></div>
                    </article>
                    <article class="theme-slide theme-pink">
                        <video class="theme-video" src="video2.mp4" autoplay muted loop playsinline preload="metadata"></video>
                        <div class="theme-overlay"></div>
                        <div class="theme-info"><span>THEME 02</span><strong>Pink Neon</strong><small>Swipe left to return</small></div>
                    </article>
                </div>
                <div class="theme-dots" id="themeDots">
                    <button class="theme-dot active" data-index="0" aria-label="White theme"></button>
                    <button class="theme-dot" data-index="1" aria-label="Pink Neon theme"></button>
                </div>
            </div>

            <!-- ACTIVATION CARD -->
            <div class="activation" id="activationArea">

                <div class="activation-head">

                    <div class="activation-title">

                        <div class="activation-icon">
                            <i data-lucide="key-round"></i>
                        </div>

                        <div>
                            <h2>Premium Activation</h2>
                            <p>Two-step authorized activation workflow</p>
                        </div>

                    </div>

                    <div class="session-badge">
                        <i></i>
                        <span id="sessionText">Session ready</span>
                    </div>

                </div>

                <!-- PROGRESS -->
                <div class="progress">

                    <div class="progress-track">

                        <div class="progress-step active" id="progress1">
                            <div class="progress-line">
                                <div></div>
                            </div>

                            <div class="progress-label">
                                <span>01</span>
                                Request Magic Link
                            </div>
                        </div>

                        <div class="progress-step" id="progress2">
                            <div class="progress-line">
                                <div></div>
                            </div>

                            <div class="progress-label">
                                <span>02</span>
                                Apply Premium
                            </div>
                        </div>

                    </div>

                </div>

                <!-- FORM AREA -->
                <div class="form-area">

                    <!-- STEP 1 -->
                    <div class="step" id="step1Card">

                        <div class="step-header">

                            <div>
                                <div class="step-number">STEP 01</div>
                                <h3>Request Magic Link</h3>
                                <p class="step-desc">
                                    Enter the authorized Alight Motion account email.
                                </p>
                            </div>

                            <div class="step-check" id="check1">
                                <i data-lucide="circle" size="15"></i>
                            </div>

                        </div>

                        <div class="field">

                            <label>Email Address</label>

                            <div class="input">

                                <i data-lucide="mail"></i>

                                <input
                                    id="emailInput"
                                    type="email"
                                    autocomplete="off"
                                    placeholder="name@example.com"
                                >

                                <div class="input-actions">

                                    <button id="copyEmailBtn">
                                        <i data-lucide="copy" size="15"></i>
                                    </button>

                                    <button id="clearEmailBtn">
                                        <i data-lucide="x" size="15"></i>
                                    </button>

                                </div>

                            </div>

                            <div class="error" id="emailError"></div>

                        </div>

                        <button class="action" id="requestLinkBtn">
                            <i data-lucide="send" size="16"></i>
                            Request Magic Link
                        </button>

                        <div class="step-status" id="step1Status"></div>

                    </div>

                    <!-- STEP 2 -->
                    <div class="step disabled" id="step2Card">

                        <div class="step-header">

                            <div>
                                <div class="step-number">STEP 02</div>
                                <h3>Apply Premium</h3>
                                <p class="step-desc">
                                    Use the magic link received from your authorized email.
                                </p>
                            </div>

                            <div class="step-check" id="check2">
                                <i data-lucide="circle" size="15"></i>
                            </div>

                        </div>

                        <div class="field">

                            <label>Email Address</label>

                            <div class="input">

                                <i data-lucide="user"></i>

                                <input
                                    id="emailStep2"
                                    type="email"
                                    autocomplete="off"
                                    placeholder="authorized@email.com"
                                >

                            </div>

                            <div class="error" id="emailStep2Error"></div>

                        </div>

                        <div class="field">

                            <label>Magic Link</label>

                            <div class="input">

                                <i data-lucide="link"></i>

                                <input
                                    id="magicLinkInput"
                                    type="password"
                                    autocomplete="off"
                                    placeholder="Paste magic link here"
                                >

                                <div class="input-actions">

                                    <button id="toggleMagicVisibility">
                                        <i data-lucide="eye" size="15"></i>
                                    </button>

                                    <button id="copyMagicBtn">
                                        <i data-lucide="copy" size="15"></i>
                                    </button>

                                    <button id="clearMagicBtn">
                                        <i data-lucide="x" size="15"></i>
                                    </button>

                                </div>

                            </div>

                            <div class="error" id="magicError"></div>

                        </div>

                        <button class="action" id="applyPremiumBtn">
                            <i data-lucide="shield-check" size="16"></i>
                            Apply Premium
                        </button>

                        <div class="step-status" id="step2Status"></div>

                    </div>

                </div>

            </div>

            <!-- RIGHT PANEL -->
            <aside class="side-panel">

                <!-- STATUS -->
                <div class="panel" id="statusArea">

                    <div class="panel-title">
                        <h3>Activation Status</h3>
                        <span id="activationTimestamp">READY</span>
                    </div>

                    <div class="status-main">

                        <div class="big-status" id="bigStatus">
                            <i data-lucide="clock-3"></i>
                        </div>

                        <div>
                            <strong id="statusLabel">
                                Waiting for activation
                            </strong>

                            <small id="statusDetail">
                                No activation request submitted.
                            </small>
                        </div>

                    </div>

                </div>

                <!-- ACTIVITY -->
                <div class="panel">

                    <div class="panel-title">
                        <h3>Recent Activity</h3>
                        <span id="logCount">0 EVENTS</span>
                    </div>

                    <div class="logs" id="activityLog">

                        <div class="log">

                            <div class="log-icon">
                                <i data-lucide="terminal" size="13"></i>
                            </div>

                            <div class="log-text">
                                <strong>Dashboard initialized</strong>
                                <span>Waiting for user action</span>
                            </div>

                        </div>

                    </div>

                </div>

                <!-- SECURITY -->
                <div class="panel" id="securityArea">

                    <div class="panel-title">
                        <h3>Security</h3>
                        <span>PROTECTED</span>
                    </div>

                    <div class="security-list">

                        <div class="security-item">
                            <i data-lucide="lock"></i>
                            HTTPS API communication
                        </div>

                        <div class="security-item">
                            <i data-lucide="eye-off"></i>
                            No account password requested
                        </div>

                        <div class="security-item">
                            <i data-lucide="shield"></i>
                            Magic link used only in session
                        </div>

                        <div class="security-item">
                            <i data-lucide="trash-2"></i>
                            Sensitive link cleared after processing
                        </div>

                    </div>

                </div>

            </aside>

        </section>

        <!-- FOOTER -->
        <footer class="footer">

            <div>
                Alight Motion Premium Activation Center
            </div>

            <div class="footer-links">
                <button id="privacyLink">Privacy</button>
                <button id="securityLink">Security</button>
                <button id="termsLink">Terms</button>
            </div>

        </footer>

    </main>

</div>

<!-- TOAST -->
<div class="toast-container" id="toastContainer"></div>

<!-- MODAL -->
<div class="modal hidden" id="modal">

    <div class="modal-box">

        <div class="modal-head">
            <h3 id="modalTitle">Privacy</h3>

            <button class="modal-close" id="modalClose">
                <i data-lucide="x"></i>
            </button>
        </div>

        <div class="modal-body" id="modalBody"></div>

    </div>

</div>

<script>

document.addEventListener("DOMContentLoaded",()=>{

    lucide.createIcons();

    const API_MAGIC =
        "https://api.kyzznekoo.my.id/api/alightmotion/v3/magic-link?email=";

    const API_PREMIUM =
        "https://api.kyzznekoo.my.id/api/alightmotion/v3/applyPremium?email=&link=";

    const $ = id => document.getElementById(id);

    const emailInput = $("emailInput");
    const emailStep2 = $("emailStep2");
    const magicLinkInput = $("magicLinkInput");

    const step2Card = $("step2Card");
    const progress2 = $("progress2");

    const check1 = $("check1");
    const check2 = $("check2");

    const statusLabel = $("statusLabel");
    const statusDetail = $("statusDetail");
    const bigStatus = $("bigStatus");

    const apiDot = $("apiDot");
    const apiLabel = $("apiLabel");

    const activityLog = $("activityLog");
    const logCount = $("logCount");

    let state = {
        email:"",
        magic:"",
        logs:[],
        requests:0,
        step1:false,
        status:"idle"
    };

    let requesting = false;
    let applying = false;

    function escapeHTML(str){
        return String(str)
            .replaceAll("&","&amp;")
            .replaceAll("<","&lt;")
            .replaceAll(">","&gt;")
            .replaceAll('"',"&quot;")
            .replaceAll("'","&#039;");
    }

    function toast(message,type="info"){

        const box = document.createElement("div");

        box.className = `toast ${type}`;

        box.innerHTML = `
            <i data-lucide="${
                type==="success"
                ? "check-circle"
                : type==="error"
                ? "alert-circle"
                : "info"
            }" size="15"></i>

            <span>${escapeHTML(message)}</span>

            <button>&times;</button>
        `;

        $("toastContainer").appendChild(box);

        lucide.createIcons();

        box.querySelector("button").onclick=()=>{
            box.remove();
        };

        setTimeout(()=>{
            if(box.parentNode) box.remove();
        },4500);
    }

    function addLog(text,detail="System event"){

        state.logs.push({
            text,
            detail,
            time:new Date().toLocaleTimeString()
        });

        if(state.logs.length>30)
            state.logs.shift();

        renderLogs();
    }

    function renderLogs(){

        if(!state.logs.length){

            activityLog.innerHTML=`
                <div class="log">
                    <div class="log-icon">
                        <i data-lucide="terminal" size="13"></i>
                    </div>

                    <div class="log-text">
                        <strong>No activity</strong>
                        <span>Waiting for action</span>
                    </div>
                </div>
            `;

            lucide.createIcons();

            logCount.textContent="0 EVENTS";

            return;
        }

        activityLog.innerHTML =
            state.logs.slice().reverse().map(log=>`

                <div class="log">

                    <div class="log-icon">
                        <i data-lucide="activity" size="13"></i>
                    </div>

                    <div class="log-text">
                        <strong>${escapeHTML(log.text)}</strong>
                        <span>${escapeHTML(log.detail)} · ${escapeHTML(log.time)}</span>
                    </div>

                </div>

            `).join("");

        logCount.textContent =
            `${state.logs.length} EVENTS`;

        lucide.createIcons();
    }

    function setStatus(status,message){

        state.status=status;

        bigStatus.className="big-status";

        if(status==="success"){
            bigStatus.classList.add("success");
            bigStatus.innerHTML=`<i data-lucide="check-circle"></i>`;
            statusLabel.textContent="Premium activation completed";
        }

        else if(status==="error"){
            bigStatus.classList.add("error");
            bigStatus.innerHTML=`<i data-lucide="alert-circle"></i>`;
            statusLabel.textContent="Activation failed";
        }

        else if(status==="processing"){
            bigStatus.classList.add("processing");
            bigStatus.innerHTML=`<i data-lucide="loader" class="spinner"></i>`;
            statusLabel.textContent="Processing activation";
        }

        else{
            bigStatus.innerHTML=`<i data-lucide="clock-3"></i>`;
            statusLabel.textContent="Waiting for activation";
        }

        statusDetail.textContent =
            message || "No activation request submitted.";

        lucide.createIcons();
    }

    function updateUI(){

        if(state.step1){

            step2Card.classList.remove("disabled");
            progress2.classList.add("active");

            check1.classList.add("done");
            check1.innerHTML=`<i data-lucide="check" size="15"></i>`;

        }else{

            step2Card.classList.add("disabled");
            progress2.classList.remove("active");

            check1.classList.remove("done");
            check1.innerHTML=`<i data-lucide="circle" size="15"></i>`;

        }

        if(state.status==="success"){

            check2.classList.add("done");
            check2.innerHTML=`<i data-lucide="check" size="15"></i>`;

        }

        emailInput.value=state.email;
        emailStep2.value=state.email;
        magicLinkInput.value=state.magic;

        $("requestCounter").textContent=state.requests;

        lucide.createIcons();
    }

    async function readResponse(response){

        const type=response.headers.get("content-type") || "";

        if(type.includes("application/json")){
            return await response.json();
        }

        return await response.text();
    }

    async function checkAPI(){

        apiLabel.textContent="Checking";

        try{

            const response=await fetch(
                API_MAGIC+"health@example.com",
                {
                    method:"GET",
                    cache:"no-store"
                }
            );

            if(
                response.ok ||
                response.status===400 ||
                response.status===404
            ){

                apiDot.className="api-dot";
                apiLabel.textContent="Online";

                return true;
            }

            throw new Error();

        }catch{

            apiDot.className="api-dot offline";
            apiLabel.textContent="Offline";

            return false;
        }
    }

    async function requestMagicLink(){

        if(requesting) return;

        const email=emailInput.value.trim();

        $("emailError").textContent="";

        if(
            !email ||
            !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)
        ){

            $("emailError").textContent=
                "Enter a valid email address.";

            return;
        }

        requesting=true;

        const button=$("requestLinkBtn");

        button.disabled=true;

        button.innerHTML=`
            <i data-lucide="loader" class="spinner" size="16"></i>
            Requesting...
        `;

        lucide.createIcons();

        const start=performance.now();

        try{

            const response=await fetch(
                API_MAGIC+
                encodeURIComponent(email),
                {
                    method:"GET",
                    cache:"no-store"
                }
            );

            const result=await readResponse(response);

            state.requests++;

            if(!response.ok){

                let message="Magic-link request failed.";

                if(response.status===429)
                    message="Too many requests.";

                if(response.status===403)
                    message="Access denied.";

                if(response.status===400)
                    message="Invalid request.";

                throw new Error(message);
            }

            state.email=email;
            state.step1=true;

            const duration=
                ((performance.now()-start)/1000).toFixed(1);

            setStatus(
                "idle",
                "Magic link requested. Continue to step 2."
            );

            addLog(
                "Magic link requested",
                `${duration}s response`
            );

            $("step1Status").textContent=
                `Request completed in ${duration}s`;

            $("sessionText").textContent=
                "Step 1 complete";

            toast(
                "Magic link request completed.",
                "success"
            );

            emailStep2.value=email;

            updateUI();

            step2Card.scrollIntoView({
                behavior:"smooth",
                block:"center"
            });

        }catch(error){

            addLog(
                "Magic-link request failed",
                error.message
            );

            $("step1Status").textContent=
                error.message;

            toast(
                error.message,
                "error"
            );

        }finally{

            requesting=false;

            button.disabled=false;

            button.innerHTML=`
                <i data-lucide="send" size="16"></i>
                Request Magic Link
            `;

            lucide.createIcons();
        }
    }

    async function applyPremium(){

        if(applying) return;

        const email=emailStep2.value.trim();
        const link=magicLinkInput.value.trim();

        $("emailStep2Error").textContent="";
        $("magicError").textContent="";

        if(
            !email ||
            !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)
        ){

            $("emailStep2Error").textContent=
                "Enter a valid email address.";

            return;
        }

        if(!link || link.length<10){

            $("magicError").textContent=
                "Enter the magic link.";

            return;
        }

        applying=true;

        const button=$("applyPremiumBtn");

        button.disabled=true;

        button.innerHTML=`
            <i data-lucide="loader" class="spinner" size="16"></i>
            Applying...
        `;

        lucide.createIcons();

        setStatus(
            "processing",
            "Sending activation request..."
        );

        addLog(
            "Activation request submitted",
            "Processing"
        );

        try{

            const url =
                "https://api.kyzznekoo.my.id/api/alightmotion/v3/applyPremium"+
                "?email="+encodeURIComponent(email)+
                "&link="+encodeURIComponent(link);

            const start=performance.now();

            const response=await fetch(
                url,
                {
                    method:"GET",
                    cache:"no-store"
                }
            );

            const result=await readResponse(response);

            state.requests++;

            if(!response.ok){

                let message="Activation request rejected.";

                if(response.status===429)
                    message="Too many requests.";

                else if(response.status===403)
                    message="Unauthorized request.";

                else if(response.status===404)
                    message="Invalid magic link or endpoint.";

                else if(response.status===400)
                    message="Invalid parameters.";

                throw new Error(message);
            }

            let success=false;
            let message="Activation completed.";

            if(typeof result==="object" && result){

                success =
                    result.success===true ||
                    result.status==="success";

                if(result.message)
                    message=result.message;

            }else{

                const text=String(result);

                message=text;

                success=
                    /success|completed|activated/i.test(text);
            }

            const duration=
                ((performance.now()-start)/1000).toFixed(1);

            if(success){

                setStatus(
                    "success",
                    message
                );

                $("step2Status").textContent=
                    `${message} · ${duration}s`;

                $("activationTimestamp").textContent=
                    new Date().toLocaleTimeString();

                $("sessionText").textContent=
                    "Activation complete";

                addLog(
                    "Premium activation completed",
                    `${duration}s response`
                );

                toast(
                    "Premium activation completed.",
                    "success"
                );

            }else{

                setStatus(
                    "error",
                    message
                );

                $("step2Status").textContent=
                    message;

                addLog(
                    "Activation returned unsuccessful result",
                    message
                );

                toast(
                    message,
                    "error"
                );
            }

        }catch(error){

            setStatus(
                "error",
                error.message
            );

            $("step2Status").textContent=
                error.message;

            addLog(
                "Activation failed",
                error.message
            );

            toast(
                error.message,
                "error"
            );

        }finally{

            applying=false;

            button.disabled=false;

            button.innerHTML=`
                <i data-lucide="shield-check" size="16"></i>
                Apply Premium
            `;

            /*
             * Jangan mempertahankan magic link setelah request selesai.
             * Ini mengurangi kemungkinan link sensitif tertinggal di halaman.
             */
            state.magic="";
            magicLinkInput.value="";

            updateUI();

            lucide.createIcons();
        }
    }

    function resetSession(){

        state={
            email:"",
            magic:"",
            logs:[],
            requests:0,
            step1:false,
            status:"idle"
        };

        $("emailError").textContent="";
        $("emailStep2Error").textContent="";
        $("magicError").textContent="";

        $("step1Status").textContent="";
        $("step2Status").textContent="";

        $("activationTimestamp").textContent="READY";
        $("sessionText").textContent="Session ready";

        setStatus(
            "idle",
            "No activation request submitted."
        );

        addLog(
            "Session reset",
            "Workspace cleared"
        );

        updateUI();

        toast(
            "Session has been reset.",
            "info"
        );
    }

    /* THEME SLIDER */
    const themeSlider=$("themeSlider"), themeTrack=$("themeTrack");
    const themeDots=document.querySelectorAll(".theme-dot");
    let currentTheme=0, touchStartX=0, touchStartY=0, mouseStartX=null;
    function setTheme(index){
        currentTheme=Math.max(0,Math.min(1,index));
        themeTrack.style.transform=`translateX(-${currentTheme*50}%)`;
        themeDots.forEach((dot,i)=>dot.classList.toggle("active",i===currentTheme));
        document.body.classList.toggle("theme-white",currentTheme===0);
        document.body.classList.toggle("theme-pink",currentTheme===1);
        themeSlider.querySelectorAll("video").forEach((v,i)=>i===currentTheme?v.play().catch(()=>{}):v.pause());
    }
    themeDots.forEach(dot=>dot.addEventListener("click",()=>setTheme(Number(dot.dataset.index))));
    themeSlider.addEventListener("touchstart",e=>{const t=e.changedTouches[0];touchStartX=t.clientX;touchStartY=t.clientY},{passive:true});
    themeSlider.addEventListener("touchend",e=>{const t=e.changedTouches[0],dx=t.clientX-touchStartX,dy=t.clientY-touchStartY;if(Math.abs(dx)>45&&Math.abs(dx)>Math.abs(dy))setTheme(dx<0?currentTheme+1:currentTheme-1)},{passive:true});
    themeSlider.addEventListener("mousedown",e=>mouseStartX=e.clientX);
    themeSlider.addEventListener("mouseup",e=>{if(mouseStartX===null)return;const dx=e.clientX-mouseStartX;if(Math.abs(dx)>45)setTheme(dx<0?currentTheme+1:currentTheme-1);mouseStartX=null});
    setTheme(0);

    /* EMAIL */

    emailInput.addEventListener("input",()=>{
        state.email=emailInput.value;
        emailStep2.value=emailInput.value;
    });

    emailStep2.addEventListener("input",()=>{
        state.email=emailStep2.value;
    });

    magicLinkInput.addEventListener("input",()=>{
        state.magic=magicLinkInput.value;
    });

    /* BUTTONS */

    $("requestLinkBtn").onclick=
        requestMagicLink;

    $("applyPremiumBtn").onclick=
        applyPremium;

    $("copyEmailBtn").onclick=async()=>{

        if(!emailInput.value) return;

        try{
            await navigator.clipboard.writeText(
                emailInput.value
            );

            toast(
                "Email copied.",
                "info"
            );

        }catch{}
    };

    $("clearEmailBtn").onclick=()=>{
        state.email="";
        emailInput.value="";
        emailStep2.value="";
    };

    $("copyMagicBtn").onclick=async()=>{

        if(!magicLinkInput.value) return;

        try{

            await navigator.clipboard.writeText(
                magicLinkInput.value
            );

            toast(
                "Magic link copied.",
                "info"
            );

        }catch{}
    };

    $("clearMagicBtn").onclick=()=>{
        state.magic="";
        magicLinkInput.value="";
    };

    $("toggleMagicVisibility").onclick=()=>{

        const visible=
            magicLinkInput.type==="text";

        magicLinkInput.type=
            visible ? "password" : "text";

        $("toggleMagicVisibility").innerHTML=
            `<i data-lucide="${
                visible ? "eye" : "eye-off"
            }" size="15"></i>`;

        lucide.createIcons();
    };

    $("clearLogsBtn").onclick=()=>{

        state.logs=[];

        renderLogs();

        toast(
            "Activity log cleared.",
            "info"
        );
    };

    $("refreshApiBtn").onclick=async()=>{

        await checkAPI();

        toast(
            "API status refreshed.",
            "info"
        );
    };

    $("resetNav").onclick=resetSession;
    $("mobileReset").onclick=resetSession;

    /* NAVIGATION */

    document.querySelectorAll(".nav button[data-target]")
        .forEach(button=>{

            button.addEventListener("click",()=>{

                document.querySelectorAll(".nav button")
                    .forEach(x=>x.classList.remove("active"));

                button.classList.add("active");

                const target=$(button.dataset.target);

                if(target){

                    target.scrollIntoView({
                        behavior:"smooth",
                        block:"start"
                    });

                }

            });

        });

    /* MODAL */

    function openModal(title,body){

        $("modalTitle").textContent=title;
        $("modalBody").textContent=body;
        $("modal").classList.remove("hidden");

    }

    function closeModal(){
        $("modal").classList.add("hidden");
    }

    $("modalClose").onclick=closeModal;

    $("modal").onclick=e=>{
        if(e.target===$("modal"))
            closeModal();
    };

    $("privacyLink").onclick=()=>openModal(
        "Privacy",
        "This interface does not intentionally persist the email address or magic link in permanent browser storage. The activation request is sent to the configured API endpoint."
    );

    $("securityLink").onclick=()=>openModal(
        "Security",
        "The interface does not request the account password. Magic-link values are cleared from the interface after the activation request finishes."
    );

    $("termsLink").onclick=()=>openModal(
        "Terms",
        "Use the activation service only with accounts and magic links you are authorized to use. Service availability and activation results are determined by the configured API."
    );

    /* KEYBOARD */

    emailInput.addEventListener("keydown",e=>{
        if(e.key==="Enter")
            requestMagicLink();
    });

    emailStep2.addEventListener("keydown",e=>{
        if(e.key==="Enter")
            applyPremium();
    });

    magicLinkInput.addEventListener("keydown",e=>{
        if(e.key==="Enter")
            applyPremium();
    });

    document.addEventListener("keydown",e=>{

        if(
            e.ctrlKey &&
            e.shiftKey &&
            e.key.toLowerCase()==="r"
        ){

            e.preventDefault();

            if(
                confirm(
                    "Reset the current activation session?"
                )
            ){

                resetSession();
            }
        }

        if(e.key==="Escape")
            $("modal").classList.add("hidden");

    });

    /* INITIALIZATION */

    addLog(
        "Dashboard initialized",
        "Activation workspace ready"
    );

    setStatus(
        "idle",
        "No activation request submitted."
    );

    updateUI();

    checkAPI();

});

</script>

</body>
</html>
